# ==============================================================
# PetGuardian API — Configurações de Ambiente (.env)
# ==============================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env no repositório.

# --------------------------------------------------------------
# OPÇÃO 1: Conectar no PostgreSQL do Railway (Nuvem)
# --------------------------------------------------------------
PGHOST=<HOST_DO_RAILWAY>
PGPORT=<PORTA_DO_RAILWAY>
PGDATABASE=<NOME_DO_BANCO>
PGUSER=<USUARIO_DO_BANCO>
PGPASSWORD=<SENHA_DO_BANCO>

# --------------------------------------------------------------
# OPÇÃO 2: Conectar no PostgreSQL Local via Docker (compose.yml)
# --------------------------------------------------------------
# Para rodar com o banco local, inicie o Docker (docker compose up -d)
# e descomente as variáveis abaixo:

# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=petguardian
# PGUSER=petguardian
# PGPASSWORD=petguardian

# --------------------------------------------------------------
# Porta da Aplicação
# --------------------------------------------------------------
PORT=8080
