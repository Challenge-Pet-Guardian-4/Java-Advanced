# ==============================================================================
# PetGuardian API - Environment Variables Template (.env.example)
# Copie este arquivo para .env e preencha com suas credenciais locais ou de nuvem.
# ==============================================================================

# Oracle Database 19c
ORACLE_URL=jdbc:oracle:thin:@//oracle.fiap.com.br:1521/orcl
ORACLE_USER=RMxxxxxx
ORACLE_PASSWORD=sua_senha_oracle

# Flyway Migrations (Oracle 19c)
# Hash oficial BCrypt da senha 123mudar para o admin inicial na migration V3
ADMIN_BCRYPT_HASH=$2a$10$CGKqNEY043BjTqp9faNVoOodCnu3uU.rLNuuHR4XqwZTXjuShRf0G

# MongoDB Atlas NoSQL (Conteudos Didaticos de Aula)
# Exemplo nuvem: mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/petguardian?retryWrites=true&w=majority
# Exemplo local: mongodb://localhost:27017/petguardian
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/petguardian?retryWrites=true&w=majority

# Servidor HTTP
PORT=8080
